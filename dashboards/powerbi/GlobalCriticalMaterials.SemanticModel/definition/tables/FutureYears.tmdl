/// Reviewed DuckDB business-layer export. See export_manifest.json for exact source SQL and snapshot selection.
table FutureYears
	lineageTag: 90c09c93-ec38-56d7-a4f8-8b4c5734e831

	column Year
		dataType: int64
		lineageTag: c9fb8318-6447-57c8-a429-4f7622c6d7c9
		summarizeBy: none
		sourceColumn: Year
		formatString: 0

	partition FutureYears = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "/FutureYears.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers,{{"Year", Int64.Type}},"en-US")
			in
				Typed
