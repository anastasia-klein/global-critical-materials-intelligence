/// Reviewed DuckDB business-layer export. See export_manifest.json for exact source SQL and snapshot selection.
table TradeYears
	lineageTag: fc30417e-6eca-57d0-a1db-e59a5142e918

	column Year
		dataType: int64
		lineageTag: f8d7aa93-f152-5c96-8a72-5efcc90937ef
		summarizeBy: none
		sourceColumn: Year
		formatString: 0

	partition TradeYears = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataFolder & "/TradeYears.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
				Typed = Table.TransformColumnTypes(Headers,{{"Year", Int64.Type}},"en-US")
			in
				Typed
