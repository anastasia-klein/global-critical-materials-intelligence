# Export environment variables explicitly; .env is not loaded automatically.
GCM_DATA_ROOT=data/raw
GCM_HTTP_TIMEOUT_SECONDS=45
GCM_HTTP_ATTEMPTS=4
GCM_HTTP_MIN_INTERVAL_SECONDS=1
# No credentials are required for the approved public IEA/Comext requests.
# Analytical builds use a local DuckDB file, configured by the build wrapper.
# GCM_DUCKDB_PATH=/absolute/path/to/gcm.duckdb
